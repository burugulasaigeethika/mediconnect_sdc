# Production Environment Variables - Backend
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-vercel-domain.vercel.app

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mediconnect?retryWrites=true&w=majority

# Security
JWT_SECRET=your_production_super_secret_jwt_key_min_32_characters

# Redis (Upstash)
REDIS_URL=rediss://default:<password>@your-redis-endpoint.upstash.io:6379
REDIS_TLS=true

# Optional Features (Email/SMTP)
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-specific-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Optional Features (Razorpay Payments)
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional Features (AWS S3 Storage for Prescriptions)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=your_s3_bucket_name
