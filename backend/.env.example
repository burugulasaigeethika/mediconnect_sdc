# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/mediconnect
# OR MongoDB Atlas (replace with your connection string):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mediconnect?retryWrites=true&w=majority

# JWT Secret (CHANGE THIS!)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long

# Email Configuration
ENABLE_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Email Sender
EMAIL_FROM=noreply@mediconnect.com

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# AWS S3 Configuration (Optional - for cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=5whoIKn2vMsY1PBr4VQzdHCpC57sLcQy5QGS1J9zOzA=
REDIS_TLS=false

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
ENABLE_PAYMENT=true